{
  "name": "vestaproject",
  "module": "index.ts",
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "^1.3.11",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.5.2"
  },
  "peerDependencies": {
    "typescript": "^5.4.5"
  },
	"scripts": {
		"assets:inline-svg-audit": "bun run scripts/generate-inline-svg-audit.ts",
		"embed-skins": "bun run scripts/embed-skins.ts",
		"embed-skins:retag": "bun run scripts/embed-skins.ts --retag",
		"embed-skins:extract": "bun run scripts/extract-embedded-skins.ts",
		"check": "cd apps/desktop-solid && bun run check",
		"format": "cd apps/desktop-solid && bun run format",
		"typecheck": "cd apps/desktop-solid && bun run typecheck",
		"vesta:dev": "cd apps/desktop-solid && bun run tauri:dev",
    "vesta:dev:tools": "cd apps/desktop-solid && bun run tauri:dev --features tauri/devtools",
    "vesta:build": "cd apps/desktop-solid && bun run tauri:build",
    "version:bump": "bun run scripts/bump-version.ts",
    "install": "cd apps/desktop-solid && bun install",
    "i": "cd apps/desktop-solid && bun i",
    "cmd": "cd apps/desktop-solid &&"
  },
  "type": "module",
  "dependencies": {
    "@niobrix/solidjs-skinview3d": "^1.0.0",
    "@tauri-controls-v2/solid": "^0.4.4",
    "chroma-js": "^3.2.0"
  }
}
