{
  "productName": "Vesta Launcher (Rewrite)",
  "identifier": "com.vesta.launcher.rewrite",
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../../apps/desktop-solid"
    },
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../apps/desktop-solid"
    },
    "frontendDist": "../../apps/desktop-solid/dist/client"
  }
}
