{
  "type": "vesta-author-theme",
  "formatVersion": 1,
  "contractVersion": 1,
  "name": "Windows 2000 capability example",
  "base": {
    "id": "vesta",
    "mode": "light",
    "hue": 207,
    "material": "flat",
    "translucency": 0,
    "grain": 0,
    "gradient": false,
    "gradientType": "radial",
    "gradientAngle": 135,
    "gradientHarmony": "analogous",
    "borderWidth": 1
  },
  "css": "/*\r\n * Trusted author-theme example, loaded only by the theme-contract story.\r\n * The scope marker is fixture-owned, not a shipped preset or an upload format.\r\n * Only public UI parts/states are used; no generated classes or !important.\r\n */\r\n@layer theme {\r\n  :root {\r\n    color-scheme: light;\r\n    --vesta-color-media-text: #fff;\r\n    --vesta-color-media-shade: #000;\r\n    --vesta-shadow-text: none;\r\n    --vesta-shadow-sm: none;\r\n    --vesta-shadow-md: none;\r\n    --vesta-shadow-lg: none;\r\n    --vesta-brand-modrinth: #145214;\r\n    --vesta-brand-curseforge: #654500;\r\n    --vesta-color-success: #145214;\r\n    --vesta-color-warning: #654500;\r\n    --vesta-font-mono: Consolas, 'Courier New', monospace;\r\n    --vesta-font-sans: Tahoma, 'MS Sans Serif', Arial, sans-serif;\r\n    --vesta-color-canvas: #3a6ea5;\r\n    --vesta-color-canvas-fill: #3a6ea5;\r\n    --vesta-color-chrome: #d4d0c8;\r\n    --vesta-color-panel: #d4d0c8;\r\n    --vesta-theme-background: none;\r\n    --vesta-theme-grain-opacity: 0;\r\n    --vesta-theme-overlay-blur: none;\r\n    --memory-selected-bg: #c0c0c0;\r\n    --memory-selected-border: #808080;\r\n    --storage-segment-lightness: 0.5;\r\n    --storage-segment-chroma: 0.13;\r\n    --vesta-color-tooltip: #ffffe1;\r\n    --vesta-color-tooltip-text: #000;\r\n    --vesta-color-surface: #d4d0c8;\r\n    --vesta-color-surface-raised: #d4d0c8;\r\n    --vesta-color-surface-sunken: #fff;\r\n    --vesta-color-text: #000;\r\n    --vesta-color-text-muted: #333;\r\n    --vesta-color-text-subtle: #555;\r\n    --vesta-color-border: #808080;\r\n    --vesta-color-border-strong: #808080;\r\n    --vesta-color-fill: #d4d0c8;\r\n    --vesta-color-fill-hover: #dfdfdf;\r\n    --vesta-color-fill-active: #c0c0c0;\r\n    --vesta-color-accent: #0a246a;\r\n    --vesta-color-accent-hover: #153b8a;\r\n    --vesta-color-accent-active: #08205c;\r\n    --vesta-color-accent-text: #0a246a;\r\n    --vesta-color-accent-border: #0a246a;\r\n    --vesta-color-on-accent: #fff;\r\n    --vesta-color-danger: #a00000;\r\n    --vesta-color-danger-hover: #b00000;\r\n    --vesta-color-danger-active: #800000;\r\n    --vesta-color-danger-text: #a00000;\r\n    --vesta-color-danger-border: #a00000;\r\n    --vesta-color-on-danger: #fff;\r\n    --vesta-color-success-text: #145214;\r\n    --vesta-color-warning-text: #654500;\r\n    --vesta-color-info-text: #0a246a;\r\n    --vesta-color-focus: #000;\r\n    --vesta-color-overlay: #d4d0c8;\r\n    --vesta-color-overlay-text: #000;\r\n    --vesta-color-scrim: rgb(0 0 0 / 20%);\r\n    /* Geometry aliases inherited from :root do not re-resolve at this scope. */\r\n    --vesta-radius-factor: 0;\r\n    --vesta-radius-sm: 0px;\r\n    --vesta-radius-md: 0px;\r\n    --vesta-radius-lg: 0px;\r\n    --vesta-radius-xl: 0px;\r\n    --vesta-radius-control: 0px;\r\n    --vesta-radius-container: 0px;\r\n    --vesta-radius-full: 0px;\r\n    --vesta-border-width: 1px;\r\n    --vesta-focus-width: 1px;\r\n    --vesta-focus-offset: -4px;\r\n    --classic-raised: inset 1px 1px 0 #fff, inset -1px -1px 0 #404040,\r\n      inset 2px 2px 0 #dfdfdf, inset -2px -2px 0 #808080;\r\n    --classic-sunken: inset 1px 1px 0 #808080, inset -1px -1px 0 #fff,\r\n      inset 2px 2px 0 #404040, inset -2px -2px 0 #dfdfdf;\r\n  }\r\n\r\n  :root :where([data-vesta='button']) {\r\n    --button-bg: #d4d0c8;\r\n    --button-bg-hover: #dfdfdf;\r\n    --button-bg-active: #d4d0c8;\r\n    --button-fg: #000;\r\n    --button-border-color: transparent;\r\n    --button-font-weight: 400;\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='button'][data-tone='danger']) {\r\n    --button-fg: var(--vesta-color-danger-text);\r\n  }\r\n\r\n  :root :where([data-vesta='button']:not([data-disabled])):active,\r\n  :root :where([data-vesta='button'][aria-expanded='true']) {\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='field']) {\r\n    --field-bg: #fff;\r\n    --field-fg: #000;\r\n    --field-border-color: transparent;\r\n    --field-border-color-hover: transparent;\r\n  }\r\n\r\n  :root :where([data-vesta='field-control']) {\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='field'][data-invalid]) :where([data-vesta='field-control']) {\r\n    box-shadow: var(--classic-sunken), 0 0 0 1px var(--vesta-color-danger-border);\r\n  }\r\n\r\n  :root :where([data-vesta='select-chevron']) {\r\n    background: #d4d0c8;\r\n    color: #000;\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='checkbox']) {\r\n    --checkbox-bg: #fff;\r\n    --checkbox-border-color: transparent;\r\n    --checkbox-fg: #000;\r\n  }\r\n\r\n  :root :where([data-vesta='checkbox-control']) {\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  /* Preserve the switch's real input, size and semantics; only its parts change. */\r\n  :root :where([data-vesta='switch-track']) {\r\n    position: relative;\r\n    background: transparent;\r\n  }\r\n\r\n  :root :where([data-vesta='switch-track'])::before {\r\n    content: '';\r\n    position: absolute;\r\n    inset-inline-end: 0;\r\n    inset-block-start: 0;\r\n    inline-size: var(--switch-height);\r\n    block-size: var(--switch-height);\r\n    background: #fff;\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='switch-thumb']) {\r\n    visibility: hidden;\r\n  }\r\n\r\n  :root :where([data-vesta='switch'][data-checked]) :where([data-vesta='switch-track'])::after {\r\n    content: '';\r\n    position: absolute;\r\n    inset-inline-end: calc(var(--switch-height) * 0.31);\r\n    inset-block-start: calc(var(--switch-height) * 0.18);\r\n    inline-size: calc(var(--switch-height) * 0.25);\r\n    block-size: calc(var(--switch-height) * 0.44);\r\n    border: solid #000;\r\n    border-width: 0 2px 2px 0;\r\n    transform: rotate(45deg);\r\n  }\r\n\r\n  :root :where([data-vesta='tabs']) {\r\n    --tab-fg: #000;\r\n    --tab-fg-selected: #000;\r\n    --tab-fg-hover: #000;\r\n    --tab-bg-hover: #dfdfdf;\r\n  }\r\n\r\n  :root :where([data-vesta='tab-list']) {\r\n    border-block-end-color: #fff;\r\n  }\r\n\r\n  :root :where([data-vesta='tab']) {\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='tab'][data-selected]) {\r\n    background: #d4d0c8;\r\n    box-shadow: inset 1px 1px 0 #fff, inset -1px 0 0 #808080;\r\n  }\r\n\r\n  :root :where([data-vesta='tab-indicator']) {\r\n    background: transparent;\r\n  }\r\n\r\n  :root :where([data-vesta='menu'], [data-vesta='select-content'], [data-vesta='dialog']) {\r\n    --overlay-bg: #d4d0c8;\r\n    --overlay-fg: #000;\r\n    --overlay-border-color: transparent;\r\n    --overlay-radius: 0px;\r\n    --overlay-backdrop: none;\r\n    --overlay-shadow: var(--classic-raised), 2px 2px 0 rgb(0 0 0 / 25%);\r\n  }\r\n\r\n  :root :where([data-vesta='menu-item'], [data-vesta='select-item']) {\r\n    --menu-item-highlight: #0a246a;\r\n    --menu-item-highlight-fg: #fff;\r\n  }\r\n\r\n  :root :where([data-vesta='menu-item'][data-tone='danger']) {\r\n    --menu-item-highlight: var(--vesta-color-danger);\r\n    --menu-item-highlight-fg: var(--vesta-color-on-danger);\r\n  }\r\n\r\n  :root :where([data-vesta='dialog-header']) {\r\n    background: linear-gradient(to right, #0a246a, #a6caf0);\r\n    color: #fff;\r\n  }\r\n\r\n  :root :where([data-vesta='dialog-title']) {\r\n    font-weight: 700;\r\n  }\r\n\r\n  :root :where([data-vesta][data-disabled]) {\r\n    opacity: 1;\r\n    color: #808080;\r\n    text-shadow: 1px 1px 0 #fff;\r\n  }\r\n\r\n  :root :where([data-vesta='field'][data-disabled]) {\r\n    --field-bg: #d4d0c8;\r\n    --field-fg: #808080;\r\n  }\r\n\r\n  :root :where([data-vesta='field'][data-disabled]) :where([data-vesta='field-control']) {\r\n    background: #d4d0c8;\r\n  }\r\n\r\n  :root :where([data-vesta]:not([data-vesta='field-input'])):focus-visible,\r\n  :root :where([data-vesta='field-control']):has(:focus-visible) {\r\n    outline: 1px dotted #000;\r\n    outline-offset: -4px;\r\n  }\r\n\r\n  :root :where([data-vesta='checkbox']:has(input:focus-visible)) :where([data-vesta='checkbox-control']),\r\n  :root :where([data-vesta='switch']:has(input:focus-visible)) :where([data-vesta='switch-track']) {\r\n    outline: 1px dotted #000;\r\n    outline-offset: 2px;\r\n  }\r\n  /* Launcher surfaces use public hooks, leaving artwork and preset miniatures intact. */\r\n  :root :where([data-vesta='board']) {\r\n    --board-bg: #d4d0c8;\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='titlebar'], [data-vesta='rail']) {\r\n    background: #d4d0c8;\r\n    color: #000;\r\n  }\r\n\r\n  :root :where([data-vesta-icon-tile]) {\r\n    --icon-tile-bg: #d4d0c8;\r\n    --icon-tile-fg: #000;\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='resources']) {\r\n    --resource-pack-tint: #c0c0c0;\r\n  }\r\n\r\n  :root :where([data-vesta='segmented-control']) {\r\n    --segmented-track-bg: #b0ada6;\r\n    --segmented-item-fg: #000;\r\n    --segmented-item-fg-hover: #000;\r\n    --segmented-item-fg-selected: #000;\r\n    --segmented-thumb-bg: #d4d0c8;\r\n    --segmented-thumb-shadow: var(--classic-sunken);\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='segmented-item']:not([data-disabled]):hover) {\r\n    background: #dfdfdf;\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='field']:has([data-vesta='slider-track'])) {\r\n    --slider-track-size: 4px;\r\n    --slider-track-bg: #808080;\r\n    --slider-fill-bg: #0a246a;\r\n    --slider-thumb-bg: #d4d0c8;\r\n    --slider-thumb-border: transparent;\r\n  }\r\n\r\n  :root :where([data-vesta='slider-track']) {\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n  :root :where([data-vesta='slider-thumb']) {\r\n    box-shadow: var(--classic-raised);\r\n  }\r\n\r\n  :root :where([data-vesta='tab']:not([data-disabled]):hover) {\r\n    background: #dfdfdf;\r\n  }\r\n\r\n  :root :where([data-vesta='project-link'], [data-vesta='project-creator']) {\r\n    color: #000;\r\n  }\r\n\r\n  :root :where([data-vesta='project-link']:hover, [data-vesta='project-creator']:hover, [data-vesta='project-header-author']:hover) {\r\n    background: #0a246a;\r\n    color: #fff;\r\n    --vesta-color-text-muted: #fff;\r\n    --vesta-color-text-subtle: #fff;\r\n  }\r\n\r\n  :root :where([data-vesta='project-creator-avatar']) {\r\n    background: #d4d0c8;\r\n    color: #000;\r\n  }\r\n\r\n  :root :where([data-vesta='dialog-header']) {\r\n    min-block-size: 24px;\r\n    flex: none;\r\n    margin-inline: 4px;\r\n    padding-inline: 6px;\r\n  }\r\n\r\n  :root :where([data-vesta='dialog-title']) {\r\n    color: #fff;\r\n    text-shadow: 1px 1px #0a246a;\r\n  }\r\n\r\n  :root :where([data-vesta='prefs-bar'], [data-vesta='prefs-instance-bar']) {\r\n    box-sizing: border-box;\r\n    padding: 2px;\r\n    box-shadow: var(--classic-sunken);\r\n  }\r\n\r\n}\r\n"
}
