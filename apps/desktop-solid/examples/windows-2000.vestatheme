{
  "type": "vesta-author-theme",
  "formatVersion": 1,
  "contractVersion": 1,
  "name": "Windows 2000 capability example",
  "base": {
    "id": "vesta",
    "mode": "light",
    "hue": 207,
    "material": "flat",
    "translucency": 0,
    "grain": 0,
    "gradient": false,
    "gradientType": "radial",
    "gradientAngle": 135,
    "gradientHarmony": "analogous",
    "borderWidth": 1
  },
  "css": "/*\n * Trusted author-theme example, loaded only by the theme-contract story.\n * The scope marker is fixture-owned, not a shipped preset or an upload format.\n * Only public UI parts/states are used; no generated classes or !important.\n */\n@layer theme {\n  :root {\n    color-scheme: light;\n    --vesta-font-sans: Tahoma, 'MS Sans Serif', Arial, sans-serif;\n    --vesta-color-canvas: #3a6ea5;\n    --vesta-color-canvas-fill: #3a6ea5;\n    --vesta-color-chrome: #d4d0c8;\n    --vesta-color-panel: #d4d0c8;\n    --vesta-theme-background: none;\n    --vesta-theme-grain-opacity: 0;\n    --vesta-theme-overlay-blur: none;\n    --memory-selected-bg: #c0c0c0;\n    --memory-selected-border: #808080;\n    --storage-segment-lightness: 0.5;\n    --storage-segment-chroma: 0.13;\n    --vesta-color-tooltip: #ffffe1;\n    --vesta-color-tooltip-text: #000;\n    --vesta-color-surface: #d4d0c8;\n    --vesta-color-surface-raised: #d4d0c8;\n    --vesta-color-surface-sunken: #fff;\n    --vesta-color-text: #000;\n    --vesta-color-text-muted: #333;\n    --vesta-color-text-subtle: #555;\n    --vesta-color-border: #808080;\n    --vesta-color-border-strong: #808080;\n    --vesta-color-fill: #d4d0c8;\n    --vesta-color-fill-hover: #dfdfdf;\n    --vesta-color-fill-active: #c0c0c0;\n    --vesta-color-accent: #0a246a;\n    --vesta-color-accent-hover: #153b8a;\n    --vesta-color-accent-active: #08205c;\n    --vesta-color-accent-text: #0a246a;\n    --vesta-color-accent-border: #0a246a;\n    --vesta-color-on-accent: #fff;\n    --vesta-color-danger: #a00000;\n    --vesta-color-danger-hover: #b00000;\n    --vesta-color-danger-active: #800000;\n    --vesta-color-danger-text: #a00000;\n    --vesta-color-danger-border: #a00000;\n    --vesta-color-on-danger: #fff;\n    --vesta-color-success-text: #145214;\n    --vesta-color-warning-text: #654500;\n    --vesta-color-info-text: #0a246a;\n    --vesta-color-focus: #000;\n    --vesta-color-overlay: #d4d0c8;\n    --vesta-color-overlay-text: #000;\n    --vesta-color-scrim: rgb(0 0 0 / 20%);\n    /* Geometry aliases inherited from :root do not re-resolve at this scope. */\n    --vesta-radius-factor: 0;\n    --vesta-radius-sm: 0px;\n    --vesta-radius-md: 0px;\n    --vesta-radius-lg: 0px;\n    --vesta-radius-xl: 0px;\n    --vesta-radius-control: 0px;\n    --vesta-radius-container: 0px;\n    --vesta-radius-full: 0px;\n    --vesta-border-width: 1px;\n    --vesta-focus-width: 1px;\n    --vesta-focus-offset: -4px;\n    --classic-raised: inset 1px 1px 0 #fff, inset -1px -1px 0 #404040,\n      inset 2px 2px 0 #dfdfdf, inset -2px -2px 0 #808080;\n    --classic-sunken: inset 1px 1px 0 #808080, inset -1px -1px 0 #fff,\n      inset 2px 2px 0 #404040, inset -2px -2px 0 #dfdfdf;\n  }\n\n  :root :where([data-vesta='button']) {\n    --button-bg: #d4d0c8;\n    --button-bg-hover: #dfdfdf;\n    --button-bg-active: #d4d0c8;\n    --button-fg: #000;\n    --button-border-color: transparent;\n    --button-font-weight: 400;\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='button'][data-tone='danger']) {\n    --button-fg: var(--vesta-color-danger-text);\n  }\n\n  :root :where([data-vesta='button']:not([data-disabled])):active,\n  :root :where([data-vesta='button'][aria-expanded='true']) {\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='field']) {\n    --field-bg: #fff;\n    --field-fg: #000;\n    --field-border-color: transparent;\n    --field-border-color-hover: transparent;\n  }\n\n  :root :where([data-vesta='field-control']) {\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='field'][data-invalid]) :where([data-vesta='field-control']) {\n    box-shadow: var(--classic-sunken), 0 0 0 1px var(--vesta-color-danger-border);\n  }\n\n  :root :where([data-vesta='select-chevron']) {\n    background: #d4d0c8;\n    color: #000;\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='checkbox']) {\n    --checkbox-bg: #fff;\n    --checkbox-border-color: transparent;\n    --checkbox-fg: #000;\n  }\n\n  :root :where([data-vesta='checkbox-control']) {\n    box-shadow: var(--classic-sunken);\n  }\n\n  /* Preserve the switch's real input, size and semantics; only its parts change. */\n  :root :where([data-vesta='switch-track']) {\n    position: relative;\n    background: transparent;\n  }\n\n  :root :where([data-vesta='switch-track'])::before {\n    content: '';\n    position: absolute;\n    inset-inline-end: 0;\n    inset-block-start: 0;\n    inline-size: var(--switch-height);\n    block-size: var(--switch-height);\n    background: #fff;\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='switch-thumb']) {\n    visibility: hidden;\n  }\n\n  :root :where([data-vesta='switch'][data-checked]) :where([data-vesta='switch-track'])::after {\n    content: '';\n    position: absolute;\n    inset-inline-end: calc(var(--switch-height) * 0.31);\n    inset-block-start: calc(var(--switch-height) * 0.18);\n    inline-size: calc(var(--switch-height) * 0.25);\n    block-size: calc(var(--switch-height) * 0.44);\n    border: solid #000;\n    border-width: 0 2px 2px 0;\n    transform: rotate(45deg);\n  }\n\n  :root :where([data-vesta='tabs']) {\n    --tab-fg: #000;\n    --tab-fg-selected: #000;\n    --tab-fg-hover: #000;\n    --tab-bg-hover: #dfdfdf;\n  }\n\n  :root :where([data-vesta='tab-list']) {\n    border-block-end-color: #fff;\n  }\n\n  :root :where([data-vesta='tab']) {\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='tab'][data-selected]) {\n    background: #d4d0c8;\n    box-shadow: inset 1px 1px 0 #fff, inset -1px 0 0 #808080;\n  }\n\n  :root :where([data-vesta='tab-indicator']) {\n    background: transparent;\n  }\n\n  :root :where([data-vesta='menu'], [data-vesta='select-content'], [data-vesta='dialog']) {\n    --overlay-bg: #d4d0c8;\n    --overlay-fg: #000;\n    --overlay-border-color: transparent;\n    --overlay-radius: 0px;\n    --overlay-backdrop: none;\n    --overlay-shadow: var(--classic-raised), 2px 2px 0 rgb(0 0 0 / 25%);\n  }\n\n  :root :where([data-vesta='menu-item'], [data-vesta='select-item']) {\n    --menu-item-highlight: #0a246a;\n    --menu-item-highlight-fg: #fff;\n  }\n\n  :root :where([data-vesta='menu-item'][data-tone='danger']) {\n    --menu-item-highlight: var(--vesta-color-danger);\n    --menu-item-highlight-fg: var(--vesta-color-on-danger);\n  }\n\n  :root :where([data-vesta='dialog-header']) {\n    background: linear-gradient(to right, #0a246a, #a6caf0);\n    color: #fff;\n  }\n\n  :root :where([data-vesta='dialog-title']) {\n    font-weight: 700;\n  }\n\n  :root :where([data-vesta][data-disabled]) {\n    opacity: 1;\n    color: #808080;\n    text-shadow: 1px 1px 0 #fff;\n  }\n\n  :root :where([data-vesta='field'][data-disabled]) {\n    --field-bg: #d4d0c8;\n    --field-fg: #808080;\n  }\n\n  :root :where([data-vesta='field'][data-disabled]) :where([data-vesta='field-control']) {\n    background: #d4d0c8;\n  }\n\n  :root :where([data-vesta]:not([data-vesta='field-input'])):focus-visible,\n  :root :where([data-vesta='field-control']):has(:focus-visible) {\n    outline: 1px dotted #000;\n    outline-offset: -4px;\n  }\n\n  :root :where([data-vesta='checkbox']:has(input:focus-visible)) :where([data-vesta='checkbox-control']),\n  :root :where([data-vesta='switch']:has(input:focus-visible)) :where([data-vesta='switch-track']) {\n    outline: 1px dotted #000;\n    outline-offset: 2px;\n  }\n  /* Launcher surfaces use public hooks, leaving artwork and preset miniatures intact. */\n  :root :where([data-vesta='board']) {\n    --board-bg: #d4d0c8;\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='titlebar'], [data-vesta='rail']) {\n    background: #d4d0c8;\n    color: #000;\n  }\n\n  :root :where([data-vesta-icon-tile]) {\n    --icon-tile-bg: #d4d0c8;\n    --icon-tile-fg: #000;\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='resources']) {\n    --resource-pack-tint: #c0c0c0;\n  }\n\n  :root :where([data-vesta='segmented-control']) {\n    --segmented-track-bg: #b0ada6;\n    --segmented-item-fg: #000;\n    --segmented-item-fg-hover: #000;\n    --segmented-item-fg-selected: #000;\n    --segmented-thumb-bg: #d4d0c8;\n    --segmented-thumb-shadow: var(--classic-sunken);\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='segmented-item']:not([data-disabled]):hover) {\n    background: #dfdfdf;\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='field']:has([data-vesta='slider-track'])) {\n    --slider-track-size: 4px;\n    --slider-track-bg: #808080;\n    --slider-fill-bg: #0a246a;\n    --slider-thumb-bg: #d4d0c8;\n    --slider-thumb-border: transparent;\n  }\n\n  :root :where([data-vesta='slider-track']) {\n    box-shadow: var(--classic-sunken);\n  }\n\n  :root :where([data-vesta='slider-thumb']) {\n    box-shadow: var(--classic-raised);\n  }\n\n  :root :where([data-vesta='tab']:not([data-disabled]):hover) {\n    background: #dfdfdf;\n  }\n\n  :root :where([data-vesta='project-link'], [data-vesta='project-creator']) {\n    color: #000;\n  }\n\n  :root :where([data-vesta='project-link']:hover, [data-vesta='project-creator']:hover, [data-vesta='project-header-author']:hover) {\n    background: #0a246a;\n    color: #fff;\n    --vesta-color-text-muted: #fff;\n    --vesta-color-text-subtle: #fff;\n  }\n\n  :root :where([data-vesta='project-creator-avatar']) {\n    background: #d4d0c8;\n    color: #000;\n  }\n\n  :root :where([data-vesta='dialog-header']) {\n    min-block-size: 24px;\n    flex: none;\n    margin-inline: 4px;\n    padding-inline: 6px;\n  }\n\n  :root :where([data-vesta='dialog-title']) {\n    color: #fff;\n    text-shadow: 1px 1px #0a246a;\n  }\n\n  :root :where([data-vesta='prefs-bar'], [data-vesta='prefs-instance-bar']) {\n    box-sizing: border-box;\n    padding: 2px;\n    box-shadow: var(--classic-sunken);\n  }\n\n}\n"
}
