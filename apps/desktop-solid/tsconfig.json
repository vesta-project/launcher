{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    // The independent UI library is imported by the app and workbench through one alias.
    "paths": {
      "@vesta/ui": ["./ui/index.ts"],
      "@vesta/ui/*": ["./ui/*"],
      "@workbench/*": ["./workbench/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".tauri-target", "src-tauri"]
}
